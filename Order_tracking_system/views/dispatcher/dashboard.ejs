function DealerDispatchedOrdersModal({ orders, dealerId, onClose, onBack, onView, onDispatch, statusFilter = 'FULLY_DISPATCHED' }) {
  const [dispatchItemsMap, setDispatchItemsMap] = useState({});

  const dispatchedOrders = orders
    .filter(o => o.dealer_id === dealerId && (statusFilter ? o.order_status === statusFilter : ['PARTIALLY_DISPATCHED', 'FULLY_DISPATCHED'].includes(o.order_status)))
    .sort((a, b) => new Date(b.dispatch_created_at) - new Date(a.dispatch_created_at));

  // Fetch dispatch items for all orders
  useEffect(() => {
    const fetchDispatchItems = async () => {
      const map = {};
      for (const order of dispatchedOrders) {
        try {
          const res = await fetch(`/api/orders/${order.order_id}/dispatch-items`, { credentials: 'include' });
          const items = await res.json();
          map[order.order_id] = items;
        } catch (e) {
          console.error(`Error fetching dispatch items for order ${order.order_id}:`, e);
          map[order.order_id] = [];
        }
      }
      setDispatchItemsMap(map);
    };
    if (dispatchedOrders.length > 0) {
      fetchDispatchItems();
    }
  }, [dispatchedOrders]);

  const dealerName = dispatchedOrders[0]?.dealer_login_name || dispatchedOrders[0]?.dealer_company_name || dispatchedOrders[0]?.dealer_name || `Dealer #${dealerId}`;
  const titleText = statusFilter === 'PARTIALLY_DISPATCHED'
    ? `📦 Partially Dispatched Orders — ${dealerName}`
    : `✅ Fully Dispatched Orders — ${dealerName}`;
  const headerBg = statusFilter === 'PARTIALLY_DISPATCHED' ? '#0dcaf0' : '#198754';

  return (
    <div className="modal d-block" tabIndex="-1" style={{ background: 'rgba(0,0,0,0.55)' }}>
      <div className="modal-dialog modal-dialog-centered modal-lg">
        <div className="modal-content">
          <div className="modal-header d-flex align-items-center justify-content-between" style={{ background: headerBg, color: '#fff' }}>
            <div className="d-flex align-items-center gap-2">
              {onBack && (
                <button type="button" className="btn btn-sm btn-light" onClick={onBack} title="Go back to dealers">
                  ← Back
                </button>
              )}
              <h5 className="modal-title mb-0">{titleText}</h5>
            </div>
            <button type="button" className="btn-close btn-close-white" onClick={onClose}></button>
          </div>
          <div className="modal-body" style={{ maxHeight: '70vh', overflowY: 'auto' }}>
            {dispatchedOrders.length === 0 ? (
              <p className="text-muted text-center py-3">No dispatched orders</p>
            ) : (
              <div className="list-group">
                {dispatchedOrders.map(order => (
                  <div key={order.order_id} className="list-group-item" style={{ padding: '1rem' }}>
                    <div className="d-flex justify-content-between align-items-start mb-2">
                      <div>
                        <div className="fw-semibold">Order #{order.order_id}</div>
                        <small className="text-muted">{fmt(order.order_date)}</small>
                      </div>
                      <StatusBadge status={order.order_status} />
                    </div>
                    <div className="row g-2 small mb-3">
                      <div className="col-12">
                        <div className="text-muted">Products</div>
                        <div>
                          {(() => {
                            const items = parseItems(order);
                            if (items.length === 0) return <span className="text-muted">—</span>;

                            // Calculate pending quantities for each product
                            const productMap = {};
                            items.forEach(item => {
                              const key = item.product_id;
                              if (!productMap[key]) {
                                productMap[key] = {
                                  product_name: item.product_name,
                                  product_id: item.product_id,
                                  order_bags: 0,
                                  order_qty: 0,
                                  dispatched_bags: 0,
                                  dispatched_qty: 0
                                };
                              }
                              productMap[key].order_bags += parseInt(item.order_bags || 0);
                              productMap[key].order_qty += parseFloat(item.order_quantity || 0);
                            });

                            // Add dispatched quantities from fetched dispatch items
                            const dispItems = dispatchItemsMap[order.order_id] || [];
                            dispItems.forEach(dispItem => {
                              const key = dispItem.dispatch_product_id;
                              if (productMap[key]) {
                                productMap[key].dispatched_bags += parseInt(dispItem.dispatch_bags || 0);
                                productMap[key].dispatched_qty += parseFloat(dispItem.dispatch_quantity || 0);
                              }
                            });

                            return (
                              <div>
                                {Object.values(productMap).map((prod, idx) => {
                                  const pending_bags = prod.order_bags - prod.dispatched_bags;
                                  const pending_qty = prod.order_qty - prod.dispatched_qty;
                                  const isPending = pending_bags > 0;
                                  return (
                                    <div key={idx} className="fw-semibold small mb-1">
                                      <div>{prod.product_name || '—'}</div>
                                      <div className="text-muted" style={{fontSize: '0.85rem'}}>
                                        Ordered: {prod.order_bags} bags ({prod.order_qty.toFixed(3)} MT)
                                        → Pending: <span className={isPending ? 'text-warning fw-bold' : 'text-success'}>{pending_bags} bags ({pending_qty.toFixed(3)} MT)</span>
                                      </div>
                                    </div>
                                  );
                                })}
                              </div>
                            );
                          })()}
                        </div>
                      </div>
                    </div>
                    {/* Action buttons */}
                    <div className="order-card-actions" style={{ marginTop: '0.75rem' }}>
                      {onView && (
                        <button className="btn btn-sm btn-outline-primary" onClick={() => onView(order)}>
                          👁️ View
                        </button>
                      )}
                      {!readOnlyMode && onDispatch && ['PARTIALLY_DISPATCHED'].includes(order.order_status) && (
                        <button className="btn btn-sm btn-warning me-1" onClick={() => onDispatch(order)}>
                          ✏️ Edit Dispatch
                        </button>
                      )}
                    </div>
                  </div>
                ))}
              </div>
            )}
          </div>
        </div>
      </div>
    </div>
  );
}

