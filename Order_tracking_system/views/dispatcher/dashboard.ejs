  useEffect(() => {
    if (!order || !order.dispatch_id) { setDispatchItems([]); return; }
    setLoadingDispatchItems(true);
    fetch(`/api/orders/${order.order_id}/dispatch-items`, { credentials: 'include' })
      .then(r => r.json())
      .then(data => setDispatchItems(Array.isArray(data) ? data.filter(i => i.dispatch_bags || i.dispatch_driver_name || i.dispatch_vehicle_number) : []))
      .catch(() => setDispatchItems([]))
      .finally(() => setLoadingDispatchItems(false));
