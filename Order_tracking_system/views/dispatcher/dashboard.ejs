                      </div>
                      <span className="badge bg-warning text-dark">{dealer.count}</span>
                    </div>
                  </button>
                ))}
              </div>
            )}
          </div>
        </div>
      </div>
    </div>
  );
}

function DealerOrdersModal({ orders, dealerId, onClose, onBack, onAccept, onDispatch, onView }) {
  const [accepting, setAccepting] = useState({});

  const dealerOrders = orders
    .filter(o => o.dealer_id === dealerId && (o.order_status === 'ORDER_PLACED' || o.order_status === 'ACCEPTED'))
    .sort((a, b) => new Date(a.order_date) - new Date(b.order_date));

  const dealerName = dealerOrders[0]?.dealer_login_name || dealerOrders[0]?.dealer_company_name || dealerOrders[0]?.dealer_name || `Dealer #${dealerId}`;

  const handleAccept = async (orderId) => {
    setAccepting(prev => ({ ...prev, [orderId]: true }));
    await onAccept(orderId);
    setAccepting(prev => ({ ...prev, [orderId]: false }));
  };

  return (
    <div className="modal d-block" tabIndex="-1" style={{ background: 'rgba(0,0,0,0.55)' }}>
      <div className="modal-dialog modal-dialog-centered modal-lg">
        <div className="modal-content">
          <div className="modal-header d-flex align-items-center justify-content-between" style={{ background: '#fd7e14', color: '#fff' }}>
            <div className="d-flex align-items-center gap-2">
              {onBack && (
                <button type="button" className="btn btn-sm btn-light" onClick={onBack} title="Go back to dealers">
                  ← Back
                </button>
              )}
              <h5 className="modal-title mb-0">⏳ Pending Orders — {dealerName}</h5>
            </div>
            <button type="button" className="btn-close btn-close-white" onClick={onClose}></button>
          </div>
          <div className="modal-body" style={{ maxHeight: '70vh', overflowY: 'auto' }}>
            {dealerOrders.length === 0 ? (
              <p className="text-muted text-center py-3">No pending orders</p>
            ) : (
              <div className="space-y-3">
                {dealerOrders.map(order => {
                  const items = parseItems(order);
                  const totalBags = items.reduce((s, i) => s + parseInt(i.order_bags || 0), 0);
                  const totalQty = items.reduce((s, i) => s + parseFloat(i.order_quantity || 0), 0);

                  return (
                    <div key={order.order_id} className="border rounded p-3" style={{ background: '#fff', borderLeft: '4px solid #fd7e14' }}>
                      <div className="d-flex justify-content-between align-items-start mb-2">
                        <div>
                          <div className="fw-semibold">Order #{order.order_id}</div>
                          <small className="text-muted">{fmt(order.order_date)}</small>
                        </div>
                        <StatusBadge status={order.order_status} />
                      </div>

                      <div className="mb-3">
                        <div className="text-muted small fw-semibold mb-2">Products</div>
                        {items.map((item, idx) => (
                          <div key={idx} className="small mb-2">
                            <div className="fw-semibold">{item.product_name || '—'}</div>
                            <div className="text-muted">
                              {item.order_bags || 0} bags • {parseFloat(item.order_quantity || 0).toFixed(3)} MT
                            </div>
                          </div>
                        ))}
                        <div className="border-top pt-2 mt-2 fw-semibold small">
                          Total: {totalBags} bags • {totalQty.toFixed(3)} MT
                        </div>
                      </div>

                      <div className="order-card-actions">
                        <button className="btn btn-sm btn-outline-primary" title="View order" onClick={() => onView(order)}>
                          👁️ View
                        </button>
                        {!readOnlyMode && (
                          <>
                            {order.order_status === 'ORDER_PLACED' && (
                              <button
                                className="btn btn-sm btn-outline-info"
                                title="Accept order"
                                disabled={accepting[order.order_id]}
                                onClick={() => handleAccept(order.order_id)}
                              >
                                {accepting[order.order_id] ? (
                                  <>
                                    <span className="spinner-border spinner-border-sm me-1"></span>
                                    Accepting...
                                  </>
                                ) : (
                                  '✅ Accept'
                                )}
                              </button>
                            )}
                            {order.order_status === 'ACCEPTED' && (
                              <button className="btn btn-sm btn-success" title="Dispatch order" onClick={() => onDispatch(order)}>
                                🚛 Dispatch
                              </button>
                            )}
                          </>
                        )}
                      </div>
                    </div>
                  );
                })}
              </div>
            )}
          </div>
        </div>
      </div>
    </div>
  );
}

