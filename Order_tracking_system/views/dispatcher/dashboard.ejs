function PendingDealersModal({ orders, onSelectDealer, onClose }) {
  const pendingOrders = orders.filter(o => o.order_status === 'ORDER_PLACED' || o.order_status === 'ACCEPTED');
  const dealerMap = {};

  pendingOrders.forEach(o => {
    if (!dealerMap[o.dealer_id]) {
      dealerMap[o.dealer_id] = {
        dealer_id: o.dealer_id,
        dealer_name: o.dealer_name,
        dealer_login_name: o.dealer_login_name,
        dealer_company_name: o.dealer_company_name,
        count: 0,
      };
    }
    dealerMap[o.dealer_id].count++;
  });

  const dealers = Object.values(dealerMap).sort((a, b) => b.count - a.count);

  return (
    <div className="modal d-block" tabIndex="-1" style={{ background: 'rgba(0,0,0,0.55)' }}>
      <div className="modal-dialog modal-dialog-centered">
        <div className="modal-content">
          <div className="modal-header" style={{ background: '#fd7e14', color: '#fff' }}>
            <h5 className="modal-title">⏳ Dealers with Pending Orders</h5>
            <button type="button" className="btn-close btn-close-white" onClick={onClose}></button>
          </div>
          <div className="modal-body">
            {dealers.length === 0 ? (
              <p className="text-muted text-center py-3">No pending orders</p>
            ) : (
              <div className="list-group">
                {dealers.map(dealer => (
                  <button
                    key={dealer.dealer_id}
                    type="button"
                    className="list-group-item list-group-item-action"
                    onClick={() => onSelectDealer(dealer.dealer_id)}
                  >
                    <div className="d-flex justify-content-between align-items-start">
                      <div className="text-start">
                        <div className="fw-semibold">{dealer.dealer_login_name || dealer.dealer_company_name || dealer.dealer_name}</div>
                        {dealer.dealer_company_name && dealer.dealer_login_name && dealer.dealer_company_name !== dealer.dealer_login_name && (
                          <small className="text-muted">{dealer.dealer_company_name}</small>
