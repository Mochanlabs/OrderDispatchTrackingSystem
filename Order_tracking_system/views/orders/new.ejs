<%- include('../partials/header') %>

<script>
  const isEditMode = <%= editOrderId ? 'true' : 'false' %>;
  const editOrderId = <% if (editOrderId) { %><%= parseInt(editOrderId) %><% } else { %>null<% } %>;
  const editDealerId = <% if (editDealerId) { %><%= parseInt(editDealerId) %><% } else { %>null<% } %>;
  const returnUrl = '<%= returnUrl || "/orders" %>';
</script>

<nav aria-label="breadcrumb" class="mb-3">
  <ol class="breadcrumb">
    <li class="breadcrumb-item"><a href="/dashboard">Dashboard</a></li>
    <li class="breadcrumb-item"><a href="<%= returnUrl %>">Orders</a></li>
    <li class="breadcrumb-item active" id="page-title"><%= editOrderId ? 'Edit Order' : 'Place New Order' %></li>
  </ol>
</nav>

<div class="row justify-content-center">
  <div class="col-lg-9">
    <div class="card shadow-sm border-0">
      <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
        <div>
          <h4 class="mb-1" id="page-header"><%= editOrderId ? 'Edit Order' : 'New Order' %></h4>
          <div class="text-muted small">Add one or more products. Party, address &amp; loading details are common to all products.</div>
        </div>
        <a href="<%= returnUrl %>" class="btn btn-outline-secondary btn-sm">Back to Orders</a>
      </div>
      <div class="card-body p-4">
        <div id="form-alert" class="alert d-none" role="alert"></div>

        <!-- Daily Limit Alert -->
        <div id="limit-info" class="alert alert-info d-none mb-4" role="alert">
          <div class="row g-2">
            <div class="col-md-6">
              <div><strong>Daily Limit:</strong> <span id="limit-value">—</span> MT</div>
            </div>
            <div class="col-md-6">
              <div><strong>Remaining:</strong> <span id="remaining-value" class="fw-bold">—</span> MT</div>
            </div>
            <div id="limit-warning" class="col-12 d-none">
              <div class="alert alert-danger py-1 px-2 mb-0">⚠️ <span id="warning-text"></span></div>
            </div>
            <div id="admin-contact" class="col-12 d-none">
              <small class="text-muted">Need to increase your limit? <a id="admin-phone-link" href="#">Contact Admin</a></small>
            </div>
          </div>
        </div>

        <form id="new-order-form" class="row g-3">

          <!-- ── Products Section ──────────────────────────────────── -->
          <div class="col-12">
            <div class="d-flex align-items-center justify-content-between mb-2">
              <label class="form-label fw-semibold mb-0">Products &amp; Quantities <span class="text-danger">*</span></label>
              <button type="button" id="add-item-btn" class="btn btn-sm btn-outline-primary">+ Add Product</button>
            </div>
            <div id="items-container">
              <!-- rows injected by JS -->
            </div>
          </div>

          <!-- ── Dealer Selection (Admin Only) ────────────────────────── -->
          <div class="col-12" id="dealer-section" style="display: none;">
            <label for="admin_dealer_select" class="form-label fw-semibold">Select Dealer <span class="text-danger">*</span></label>
            <select id="admin_dealer_select" class="form-select">
              <option value="">Loading dealers…</option>
            </select>
          </div>

          <!-- ── Party Section ─────────────────────────────────────── -->
          <div class="col-12">
            <div class="d-flex align-items-center justify-content-between mb-2">
              <label class="form-label fw-semibold mb-0">Ship to Party</label>
              <div class="form-check form-switch mb-0">
                <input class="form-check-input" type="checkbox" id="new-party-toggle">
                <label class="form-check-label small" for="new-party-toggle">Add New Party</label>
              </div>
            </div>

            <div id="existing-party-section">
              <select id="party_select" class="form-select" required>
                <option value="">Loading parties…</option>
              </select>
              <input type="hidden" id="party_id" name="party_id">
            </div>

            <div id="new-party-section" class="d-none">
              <div class="row g-3">
                <div class="col-md-6">
                  <label class="form-label fw-semibold small">Party Code <span class="text-muted fw-normal">(optional)</span></label>
                  <input id="new_party_code" name="new_party_code" type="text" class="form-control" placeholder="Auto-generated if empty" autocomplete="off">
                </div>
                <div class="col-md-6">
                  <label class="form-label fw-semibold small">Party Name <span class="text-danger">*</span></label>
                  <input id="new_party_company_name" name="new_party_company_name" type="text" class="form-control" placeholder="Party name" autocomplete="off">
                </div>
                <div class="col-md-6 d-none">
                  <label class="form-label fw-semibold small">Party Name <span class="text-muted fw-normal">(optional)</span></label>
                  <input id="new_party_name" name="new_party_name" type="text" class="form-control" placeholder="Contact person name" autocomplete="off">
                </div>
                <div class="col-md-6">
                  <label class="form-label fw-semibold small">Phone <span class="text-danger">*</span> <span class="text-muted fw-normal">(10 digits only)</span></label>
                  <input id="new_party_phone" name="new_party_phone" type="tel" class="form-control" placeholder="10-digit number" maxlength="10" pattern="[0-9]{10}" title="Phone must be exactly 10 digits (0-9 only)">
                </div>
                <div class="col-md-6 d-none">
                  <label class="form-label fw-semibold small">Email <span class="text-muted fw-normal">(optional)</span></label>
                  <input id="new_party_email" name="new_party_email" type="email" class="form-control" placeholder="Email address">
                </div>
                <div class="col-12">
                  <label class="form-label fw-semibold small">Address <span class="text-danger">*</span></label>
                  <textarea id="new_party_address" name="new_party_address" class="form-control" rows="2" placeholder="Delivery address"></textarea>
                </div>
              </div>
            </div>
          </div>

          <div id="contact_number_section" class="col-md-6">
            <label for="contact_number" class="form-label fw-semibold">Contact Number <span class="text-muted fw-normal small">(10 digits only)</span></label>
            <input id="contact_number" type="tel" class="form-control" placeholder="10-digit number" maxlength="10" pattern="[0-9]{10}" title="Contact number must be exactly 10 digits (0-9 only)">
          </div>

          <div id="delivery_address_section" class="col-12">
            <label for="delivery_address" class="form-label fw-semibold">Delivery Address</label>
            <textarea id="delivery_address" class="form-control" rows="2" placeholder="Auto-filled or enter manually"></textarea>
          </div>

          <div class="col-md-6">
            <label for="load_type_code" class="form-label fw-semibold">Loading Type <span class="text-danger">*</span></label>
            <select id="load_type_code" class="form-select" required>
              <option value="">Loading…</option>
            </select>
          </div>

          <div class="col-md-6">
            <label for="preferred_location_code" class="form-label fw-semibold">
              Preferred Loading Location
              <span id="location-required-mark" class="text-danger d-none">*</span>
            </label>
            <select id="preferred_location_code" class="form-select">
              <option value="">Loading…</option>
            </select>
          </div>

          <!-- Self DOT Driver Details (shown only when Self DOT selected) -->
          <div id="dot-driver-section" class="col-12 d-none">
            <div class="p-3 border rounded" style="background:#f0f8ff; border-color:#b0d4f1 !important;">
              <div class="fw-semibold small text-primary mb-3">🚛 Self DOT — Driver Details</div>
              <div class="row g-3">
                <div class="col-md-4">
                  <label class="form-label fw-semibold small">Driver Name</label>
                  <input type="text" id="driver_name" class="form-control" placeholder="e.g. Ramesh Kumar">
                </div>
                <div class="col-md-4">
                  <label class="form-label fw-semibold small">Driver Phone <span class="text-muted fw-normal">(10 digits only)</span></label>
                  <input type="tel" id="driver_phone" class="form-control" placeholder="10-digit number" maxlength="10" pattern="[0-9]{10}" title="Driver phone must be exactly 10 digits (0-9 only)">
                </div>
                <div class="col-md-4">
                  <label class="form-label fw-semibold small">Vehicle Number</label>
                  <input type="text" id="vehicle_number" class="form-control" placeholder="e.g. MH12AB1234">
                </div>
              </div>
            </div>
          </div>

          <div class="col-12 d-flex gap-2 justify-content-end pt-2">
            <a href="<%= returnUrl %>" class="btn btn-light border">Cancel</a>
            <button type="submit" class="btn btn-primary" id="submit-btn"><%= editOrderId ? 'Update Order' : 'Place Order' %></button>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>

<script>
  let productsData = [];
  let dealerLimit = null;
  const repeatOrderId = new URLSearchParams(window.location.search).get('repeat');
  const editingOrderId = isEditMode ? editOrderId : null;

  // ── Load dealer limit ────────────────────────────────────────────────────
  (async () => {
    try {
      const res = await fetch('/api/dealer/limit');
      dealerLimit = await res.json();
      const limtInfoDiv = document.getElementById('limit-info');
      if (dealerLimit.daily_limit > 0) {
        document.getElementById('limit-value').textContent = dealerLimit.daily_limit.toFixed(3);
        document.getElementById('remaining-value').textContent = dealerLimit.remaining.toFixed(3);
        limtInfoDiv.classList.remove('d-none');

        // Show admin contact if limit is low (≥70%)
        if (dealerLimit.percentage >= 70) {
          const adminContactDiv = document.getElementById('admin-contact');
          const adminPhoneLink = document.getElementById('admin-phone-link');
          if (dealerLimit.admin_phone) {
            adminPhoneLink.href = `tel:${dealerLimit.admin_phone}`;
            adminPhoneLink.textContent = dealerLimit.admin_phone;
            adminContactDiv.classList.remove('d-none');
          }
        }
      }
    } catch (e) {
      console.error('Failed to load limit:', e);
    }
  })();

  // ── Item rows ────────────────────────────────────────────────────────────
  function buildProductOptions() {
    const blank = '<option value="">Select Product</option>';
    return blank + productsData.map(p =>
      `<option value="${p.product_id}">${p.product_name}</option>`
    ).join('');
  }

  function updateRemoveButtons() {
    const rows = document.querySelectorAll('.item-row');
    rows.forEach(row => {
      row.querySelector('.remove-item').style.visibility = rows.length === 1 ? 'hidden' : 'visible';
    });
  }

  const KG_PER_BAG = 50;

  function createItemRow() {
    const div = document.createElement('div');
    div.className = 'item-row row g-2 mb-2 align-items-end p-2 border rounded bg-light';
    div.innerHTML = `
      <div class="col-md-5">
        <label class="form-label fw-semibold small mb-1">Product <span class="text-danger">*</span></label>
        <select class="form-select item-product" required>${buildProductOptions()}</select>
      </div>
      <div class="col-md-3">
        <label class="form-label fw-semibold small mb-1">No. of Bags <span class="text-danger">*</span></label>
        <input type="number" min="1" step="1" class="form-control item-bags" placeholder="e.g. 100" required>
      </div>
      <div class="col-md-3">
        <label class="form-label fw-semibold small mb-1">
          Quantity (MT)
          <span class="text-muted fw-normal" style="font-size:.75rem"> = bags × ${KG_PER_BAG}kg</span>
        </label>
        <input type="number" step="0.001" class="form-control item-qty bg-light" placeholder="Auto-calculated" readonly tabindex="-1">
      </div>
      <div class="col-md-1 d-flex align-items-end pb-1">
        <button type="button" class="btn btn-outline-danger btn-sm remove-item" style="visibility:hidden">×</button>
      </div>
    `;
    div.querySelector('.remove-item').addEventListener('click', () => {
      div.remove();
      updateRemoveButtons();
    });

    // Auto-calculate MT when bags changes
    div.querySelector('.item-bags').addEventListener('input', function () {
      const bags = parseInt(this.value, 10);
      const qtyField = div.querySelector('.item-qty');
      if (bags > 0) {
        qtyField.value = (bags * KG_PER_BAG / 1000).toFixed(3);
      } else {
        qtyField.value = '';
      }
    });

    return div;
  }

  // ── Load dropdowns ───────────────────────────────────────────────────────
  (async () => {
    // Products (needed before first row is created)
    try {
      const res = await fetch('/api/dealer/products');
      productsData = await res.json();
    } catch (e) {
      productsData = [];
    }
    // Add first item row
    document.getElementById('items-container').appendChild(createItemRow());

    document.getElementById('add-item-btn').addEventListener('click', () => {
      document.getElementById('items-container').appendChild(createItemRow());
      updateRemoveButtons();
    });
  })();

  // Loading Type
  let loadingCodes = [];
  (async () => {
    const sel = document.getElementById('load_type_code');
    try {
      const res = await fetch('/api/codes/loading_type');
      loadingCodes = await res.json();
      sel.innerHTML = '<option value="">Select Loading Type</option>';
      loadingCodes.forEach(c => {
        const opt = document.createElement('option');
        opt.value = c.code;
        opt.textContent = c.code_label || c.code_desc || c.code;
        sel.appendChild(opt);
      });
    } catch (e) { sel.innerHTML = '<option value="">Failed to load</option>'; }
  })();

  // Preferred Loading Location (grouped)
  (async () => {
    const sel = document.getElementById('preferred_location_code');
    try {
      const res = await fetch('/api/codes/loading_location');
      const codes = await res.json();
      sel.innerHTML = '<option value="">Select Preferred Location</option>';
      const groups = {};
      codes.forEach(c => {
        const grp = c.code_label || 'Other';
        if (!groups[grp]) groups[grp] = [];
        groups[grp].push(c);
      });
      Object.entries(groups).forEach(([label, items]) => {
        const og = document.createElement('optgroup');
        og.label = label.charAt(0) + label.slice(1).toLowerCase();
        items.forEach(c => {
          const opt = document.createElement('option');
          opt.value = c.code;
          opt.textContent = c.code_desc;
          og.appendChild(opt);
        });
        sel.appendChild(og);
      });
    } catch (e) { sel.innerHTML = '<option value="">Failed to load</option>'; }
  })();

  // Helper: detect Company Transport by code value
  function isCompanyTransportCode(code) {
    if (!code) return false;
    const found = loadingCodes.find(c => c.code === code);
    if (!found) return false;
    const label = (found.code_label || found.code_desc || '').toUpperCase();
    return label.includes('COMPANY') && label.includes('TRANSPORT');
  }

  // Self DOT Driver Section visibility & Preferred Location conditional validation
  function updateLoadTypeValidation() {
    const loadTypeSelect = document.getElementById('load_type_code');
    const selectedCode = loadTypeSelect.value;

    const dotSection = document.getElementById('dot-driver-section');
    const locationSelect = document.getElementById('preferred_location_code');
    const locationRequiredMark = document.getElementById('location-required-mark');

    // Show/hide Self DOT section
    if (selectedCode === 'SLF_DOT') {
      dotSection.classList.remove('d-none');
    } else {
      dotSection.classList.add('d-none');
      document.getElementById('driver_name').value = '';
      document.getElementById('driver_phone').value = '';
      document.getElementById('vehicle_number').value = '';
    }

    // Make Preferred Location mandatory/optional based on loading type
    const isCompanyTransport = isCompanyTransportCode(selectedCode);

    if (isCompanyTransport) {
      // Company Transport - preferred location is optional
      locationSelect.required = false;
      locationRequiredMark.classList.add('d-none');
    } else if (selectedCode) {
      // Other loading types - preferred location is mandatory
      locationSelect.required = true;
      locationRequiredMark.classList.remove('d-none');
    } else {
      // No loading type selected - preferred location is optional
      locationSelect.required = false;
      locationRequiredMark.classList.add('d-none');
    }
  }

  document.getElementById('load_type_code').addEventListener('change', updateLoadTypeValidation);

  // ── Dealer Selection (Admin Only) ──────────────────────────────────────────
  let currentAdminDealerId = null;
  let dealersData = [];

  (async () => {
    // Check if user is admin by making an API call or checking if dealer_id is null
    // If this is an admin placing a new order (not editing), load dealers
    if (isEditMode && editDealerId) {
      // Editing an existing order - dealer is already set
      currentAdminDealerId = editDealerId;
    } else if (!editDealerId) {
      // New order - check if we need to show dealer selector
      try {
        const meRes = await fetch('/api/me');
        const me = await meRes.json();
        if (me && !me.dealer_id && (me.role === 'ADMIN' || me.role === 'OFFICE_EXECUTIVE')) {
          // This is an admin/office executive without a dealer_id - show dealer selector
          const dealerSection = document.getElementById('dealer-section');
          dealerSection.style.display = 'block';

          const dealerSelect = document.getElementById('admin_dealer_select');
          try {
            const dealersRes = await fetch('/api/dealers');
            dealersData = await dealersRes.json();
            dealerSelect.innerHTML = '<option value="">Select Dealer</option>';
            dealersData.forEach(d => {
              const opt = document.createElement('option');
              opt.value = d.dealer_id;
              opt.textContent = d.dealer_name;
              dealerSelect.appendChild(opt);
            });

            // When dealer is selected, reload parties
            dealerSelect.addEventListener('change', function() {
              currentAdminDealerId = this.value;
              loadPartiesForDealer(this.value);
            });
          } catch (e) {
            dealerSelect.innerHTML = '<option value="">Failed to load dealers</option>';
          }
        }
      } catch (e) {
        console.error('Failed to check user role:', e);
      }
    }
  })();

  function loadPartiesForDealer(dealerId) {
    const sel = document.getElementById('party_select');
    if (!dealerId) {
      sel.innerHTML = '<option value="">Select Dealer First</option>';
      return;
    }

    (async () => {
      try {
        const res = await fetch(`/api/admin/parties/${dealerId}`);
        partiesData = await res.json();
        sel.innerHTML = '<option value="">Select Party</option>';
        if (partiesData.length === 0) {
          sel.innerHTML = '<option value="">No parties found — add a new one</option>';
        } else {
          partiesData.forEach(p => {
            const opt = document.createElement('option');
            opt.value = p.party_id;
            opt.textContent = p.party_company_name;
            sel.appendChild(opt);
          });
        }
      } catch (e) {
        sel.innerHTML = '<option value="">Failed to load parties</option>';
      }
    })();
  }

  // ── Party logic ──────────────────────────────────────────────────────────
  let partiesData = [];

  (async () => {
    const sel = document.getElementById('party_select');
    try {
      // Determine which endpoint to use for loading parties
      let url;
      if (editDealerId) {
        // Editing an order - use the edit dealer ID
        url = `/api/admin/parties/${editDealerId}`;
      } else if (currentAdminDealerId) {
        // Admin placing new order - use selected dealer
        url = `/api/admin/parties/${currentAdminDealerId}`;
      } else {
        // Dealer placing order - use their own dealer
        url = '/api/dealer/parties';
      }

      const res = await fetch(url);
      partiesData = await res.json();
      sel.innerHTML = '<option value="">Select Party</option>';
      if (partiesData.length === 0) {
        sel.innerHTML = '<option value="">No parties found — add a new one</option>';
      } else {
        partiesData.forEach(p => {
          const opt = document.createElement('option');
          opt.value = p.party_id;
          opt.textContent = p.party_company_name;
          sel.appendChild(opt);
        });
      }
    } catch (e) { sel.innerHTML = '<option value="">Failed to load parties</option>'; }
  })();

  document.getElementById('party_select').addEventListener('change', function () {
    const selected = partiesData.find(p => String(p.party_id) === this.value);
    document.getElementById('party_id').value = this.value;
    document.getElementById('contact_number').value  = selected ? (selected.party_phone   || '') : '';
    document.getElementById('delivery_address').value = selected ? (selected.party_address || '') : '';
  });

  // ── Phone validation (EXACTLY 10 digits only) ──────────────────────────────
  const validatePhone = (val) => {
    const cleaned = val.replace(/[^0-9]/g, '');
    return cleaned.slice(0, 10); // Max 10 digits
  };
  const isValidPhone = (val) => /^\d{10}$/.test(val.replace(/[^0-9]/g, '')); // Exactly 10 digits

  document.getElementById('new_party_phone').addEventListener('input', function () {
    this.value = validatePhone(this.value);
    document.getElementById('contact_number').value = this.value;
  });
  document.getElementById('contact_number').addEventListener('input', function () {
    this.value = validatePhone(this.value);
  });
  document.getElementById('new_party_address').addEventListener('input', function () {
    document.getElementById('delivery_address').value = this.value;
  });

  document.getElementById('new-party-toggle').addEventListener('change', function () {
    const isNew = this.checked;
    document.getElementById('existing-party-section').classList.toggle('d-none', isNew);
    document.getElementById('new-party-section').classList.toggle('d-none', !isNew);
    document.getElementById('contact_number_section').classList.toggle('d-none', isNew);
    document.getElementById('delivery_address_section').classList.toggle('d-none', isNew);
    document.getElementById('party_select').required = !isNew;
    if (isNew) {
      document.getElementById('party_id').value = '';
      document.getElementById('contact_number').value  = '';
      document.getElementById('delivery_address').value = '';
    } else {
      document.getElementById('party_select').dispatchEvent(new Event('change'));
    }
  });

  // ── Repeat Order: Prefill form with original order data ──────────────────
  async function prefillRepeatOrder() {
    if (!repeatOrderId) return;
    try {
      console.log(`[Repeat Order] Fetching order #${repeatOrderId}...`);
      const res = await fetch(`/api/dealer/orders/${repeatOrderId}`, { credentials: 'include' });
      if (!res.ok) {
        console.error(`[Repeat Order] Failed to fetch order: ${res.status}`);
        return;
      }
      const order = await res.json();
      console.log(`[Repeat Order] Order data received:`, order);

      // Clear existing rows and prefill items
      const container = document.getElementById('items-container');
      container.innerHTML = '';
      const itemsToFill = (order.items && order.items.length > 0) ? order.items : [{}];
      itemsToFill.forEach(item => {
        const newRow = createItemRow();
        container.appendChild(newRow);
        if (item.product_id) {
          newRow.querySelector('.item-product').value = item.product_id;
        }
        if (item.order_bags) {
          const bagsInput = newRow.querySelector('.item-bags');
          bagsInput.value = item.order_bags;
          bagsInput.dispatchEvent(new Event('input'));
        }
      });
      updateRemoveButtons();

      // Prefill party
      if (order.party_id) {
        const partySelect = document.getElementById('party_select');
        partySelect.value = order.party_id;
        partySelect.dispatchEvent(new Event('change'));
      }

      // Prefill load type
      if (order.load_type_code) {
        document.getElementById('load_type_code').value = order.load_type_code;
        document.getElementById('load_type_code').dispatchEvent(new Event('change'));
      }

      // Prefill preferred location
      if (order.preferred_location_code) {
        document.getElementById('preferred_location_code').value = order.preferred_location_code;
      }

      // Prefill Self DOT driver fields if applicable
      if (order.load_type_code === 'SLF_DOT') {
        if (order.driver_name_on_order) {
          document.getElementById('driver_name').value = order.driver_name_on_order;
        }
        if (order.driver_phone_on_order) {
          document.getElementById('driver_phone').value = order.driver_phone_on_order;
        }
        if (order.vehicle_number_on_order) {
          document.getElementById('vehicle_number').value = order.vehicle_number_on_order;
        }
      }

      // Show info banner
      const banner = document.createElement('div');
      banner.className = 'alert alert-info mb-3';
      banner.innerHTML = `🔁 <strong>Repeating Order #${repeatOrderId}</strong> — Details have been prefilled. Review and change before submitting.`;
      document.getElementById('new-order-form').insertBefore(banner, document.getElementById('new-order-form').firstChild);
    } catch (e) {
      console.error('Failed to prefill repeat order:', e);
    }
  }

  // Call prefill after a delay to ensure all dropdowns are loaded
  if (repeatOrderId) {
    setTimeout(prefillRepeatOrder, 1000);
  }

  async function prefillEditOrder() {
    if (!editingOrderId) return;
    try {
      console.log(`[Edit Order] Fetching order #${editingOrderId}...`);
      const res = await fetch(`/api/dealer/orders/${editingOrderId}`, { credentials: 'include' });
      if (!res.ok) {
        console.error(`[Edit Order] Failed to fetch order: ${res.status}`);
        alert('Failed to load order details');
        window.location.href = '/orders';
        return;
      }
      const order = await res.json();
      console.log(`[Edit Order] Order data received:`, order);

      // Check if order is in ORDER_PLACED status
      if (order.order_status !== 'ORDER_PLACED') {
        alert('Order can only be edited when in ORDER_PLACED status');
        window.location.href = returnUrl;
        return;
      }

      // Clear existing rows and prefill items
      const container = document.getElementById('items-container');
      container.innerHTML = '';
      const itemsToFill = (order.items && order.items.length > 0) ? order.items : [{}];
      itemsToFill.forEach(item => {
        const newRow = createItemRow();
        container.appendChild(newRow);
        if (item.product_id) {
          newRow.querySelector('.item-product').value = item.product_id;
        }
        if (item.order_bags) {
          const bagsInput = newRow.querySelector('.item-bags');
          bagsInput.value = item.order_bags;
          bagsInput.dispatchEvent(new Event('input'));
        }
      });
      updateRemoveButtons();

      // Prefill party
      if (order.party_id) {
        const partySelect = document.getElementById('party_select');
        partySelect.value = order.party_id;
        partySelect.dispatchEvent(new Event('change'));
      }

      // Prefill contact number and address
      if (order.party_phone) {
        document.getElementById('contact_number').value = order.party_phone;
      }
      if (order.party_address) {
        document.getElementById('delivery_address').value = order.party_address;
      }

      // Prefill load type
      if (order.load_type_code) {
        document.getElementById('load_type_code').value = order.load_type_code;
        document.getElementById('load_type_code').dispatchEvent(new Event('change'));
      }

      // Prefill preferred location
      if (order.preferred_location_code) {
        document.getElementById('preferred_location_code').value = order.preferred_location_code;
      }

      // Prefill Self DOT driver fields if applicable
      if (order.load_type_code === 'SLF_DOT') {
        if (order.driver_name_on_order) {
          document.getElementById('driver_name').value = order.driver_name_on_order;
        }
        if (order.driver_phone_on_order) {
          document.getElementById('driver_phone').value = order.driver_phone_on_order;
        }
        if (order.vehicle_number_on_order) {
          document.getElementById('vehicle_number').value = order.vehicle_number_on_order;
        }
      }

      // Show info banner
      const banner = document.createElement('div');
      banner.className = 'alert alert-warning mb-3';
      banner.innerHTML = `✏️ <strong>Editing Order #${editingOrderId}</strong> — This order is in ORDER_PLACED status. You can modify the details below.`;
      document.getElementById('new-order-form').insertBefore(banner, document.getElementById('new-order-form').firstChild);
    } catch (e) {
      console.error('Failed to prefill edit order:', e);
      alert('Error loading order: ' + e.message);
      window.location.href = returnUrl;
    }
  }

  if (editingOrderId) {
    setTimeout(prefillEditOrder, 1000);
  }

  // ── Form submit ──────────────────────────────────────────────────────────
  const form      = document.getElementById('new-order-form');
  const submitBtn = document.getElementById('submit-btn');
  const alertBox  = document.getElementById('form-alert');

  function showAlert(type, message) {
    alertBox.className = `alert alert-${type}`;
    alertBox.textContent = message;
  }

  form.addEventListener('submit', async (event) => {
    event.preventDefault();
    submitBtn.disabled = true;
    submitBtn.textContent = 'Submitting...';
    alertBox.className = 'alert d-none';

    const isNew = document.getElementById('new-party-toggle').checked;
    let party_id = document.getElementById('party_id').value;

    try {
      // Collect and validate item rows
      const itemRows = document.querySelectorAll('.item-row');
      const items = [];
      for (let idx = 0; idx < itemRows.length; idx++) {
        const row = itemRows[idx];
        const product_id = row.querySelector('.item-product').value;
        const bags       = row.querySelector('.item-bags').value.trim();
        if (!product_id) throw new Error(`Row ${idx + 1}: please select a product`);
        const bagsQty = parseInt(bags, 10);
        if (!bags || bagsQty <= 0) throw new Error(`Row ${idx + 1}: quantity must be greater than 0`);
        const order_quantity = parseFloat((bagsQty * KG_PER_BAG / 1000).toFixed(3));
        items.push({ product_id: parseInt(product_id), order_bags: bagsQty, order_quantity });
      }
      if (items.length === 0) throw new Error('At least one product is required');

      // Create new party if needed
      if (isNew) {
        const partyCode = document.getElementById('new_party_code').value.trim();
        const partyCompanyName = document.getElementById('new_party_company_name').value.trim();
        const partyName = document.getElementById('new_party_name').value.trim();
        const partyPhone = document.getElementById('new_party_phone').value.trim();
        const partyEmail = document.getElementById('new_party_email').value.trim();
        const partyAddress = document.getElementById('new_party_address').value.trim();

        if (!partyCompanyName) throw new Error('Company name is required.');
        if (!partyPhone) throw new Error('Phone number is required.');
        if (!isValidPhone(partyPhone)) throw new Error('Phone number must be exactly 10 digits.');
        if (!partyAddress) throw new Error('Address is required.');

        const pRes = await fetch('/api/dealer/parties', {
          method:  'POST',
          headers: { 'Content-Type': 'application/json' },
          body:    JSON.stringify({
            party_code:          partyCode || null,
            party_company_name:  partyCompanyName,
            party_name:          partyName || null,
            party_phone:         partyPhone,
            party_email:         partyEmail || null,
            party_address:       partyAddress,
          }),
        });
        const pData = await pRes.json();
        if (!pRes.ok) throw new Error(pData.error || 'Failed to create party');
        party_id = pData.party_id;
      } else {
        if (!party_id) throw new Error('Please select a party.');
      }

      // Validate loading type
      const loadTypeCode = document.getElementById('load_type_code').value;
      if (!loadTypeCode) throw new Error('Loading Type is required.');

      // Validate preferred location based on loading type
      const isCompanyTransport = isCompanyTransportCode(loadTypeCode);
      const preferredLocationCode = document.getElementById('preferred_location_code').value;

      if (!isCompanyTransport && !preferredLocationCode) {
        throw new Error('Preferred Loading Location is required for this loading type.');
      }

      // Check total quantity against limit
      const totalQty = items.reduce((sum, item) => sum + item.order_quantity, 0);
      if (dealerLimit && dealerLimit.daily_limit > 0) {
        if (totalQty > dealerLimit.remaining) {
          const contactMsg = dealerLimit.admin_phone ? ` Call Admin: ${dealerLimit.admin_phone}` : '';
          throw new Error(`Order quantity (${totalQty.toFixed(3)} MT) exceeds remaining daily limit (${dealerLimit.remaining.toFixed(3)} MT). ${dealerLimit.percentage.toFixed(0)}% of limit already used. Contact Admin to increase your limit.${contactMsg}`);
        }
        if (totalQty >= dealerLimit.remaining * 0.8) {
          const proceed = confirm(`⚠️ Warning: This order will use ${(totalQty / dealerLimit.daily_limit * 100).toFixed(0)}% of your daily limit. Continue?`);
          if (!proceed) throw new Error('Order cancelled by user');
        }
      }

      // Validate driver phone if provided
      const driverPhone = document.getElementById('driver_phone').value.trim();
      if (driverPhone && !isValidPhone(driverPhone)) {
        throw new Error('Driver phone number must be exactly 10 digits.');
      }

      const payload = {
        items,
        party_id,
        load_type_code:          loadTypeCode,
        preferred_location_code: preferredLocationCode || null,
        driver_name:             document.getElementById('driver_name').value.trim()      || null,
        driver_phone:            driverPhone || null,
        vehicle_number:          document.getElementById('vehicle_number').value.trim()  || null,
      };

      // For admin creating new order, include dealer_id and use /api/admin/orders
      let url, method;
      if (editingOrderId) {
        url = `/api/dealer/orders/${editingOrderId}`;
        method = 'PUT';
      } else if (currentAdminDealerId) {
        // Admin creating order - must provide dealer_id
        payload.dealer_id = parseInt(currentAdminDealerId, 10);
        url = '/api/admin/orders';
        method = 'POST';
      } else {
        // Dealer creating order
        url = '/api/dealer/orders';
        method = 'POST';
      }

      const response = await fetch(url, {
        method:  method,
        headers: { 'Content-Type': 'application/json' },
        body:    JSON.stringify(payload),
      });

      const data = await response.json();
      if (!response.ok) {
        let errorMsg = data.error || (editingOrderId ? 'Failed to update order' : 'Failed to create order');
        if (data.error && dealerLimit && dealerLimit.admin_phone) {
          errorMsg += ` | Contact Admin: ${dealerLimit.admin_phone}`;
        }
        throw new Error(errorMsg);
      }

      const successMsg = editingOrderId ? `Order #${data.order_id} updated successfully.` : `Order #${data.order_id} placed successfully.`;
      showAlert('success', successMsg);
      window.setTimeout(() => { window.location.href = returnUrl; }, 800);
    } catch (error) {
      showAlert('danger', error.message);
    } finally {
      submitBtn.disabled = false;
      submitBtn.textContent = editingOrderId ? 'Update Order' : 'Place Order';
    }
  });

  // ── Driver phone validation (10 digits only) ──────────────────────────────
  document.getElementById('driver_phone').addEventListener('input', function(e) {
    e.target.value = e.target.value.replace(/[^0-9]/g, '').slice(0, 10);
  });
</script>

